source "https://rubygems.org"

# Core Application
gem "jekyll", "~> 4.4.1"

# Crucial Standard Library Shims for Ruby 4.0+ Runtime
gem "logger"
gem "webrick"

# Plugins
gem "jekyll-sitemap"
gem "jekyll-seo-tag"

# Performance-booster for watching directories on Windows
# Updated platform symbol format to support modern Windows Ruby 4 environments
gem "wdm", "~> 0.2.0", :platforms => [:windows, :mingw, :x64_mingw, :mswin]
